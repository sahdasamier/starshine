rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(userPath()).data;
    }

    function active() {
      return signedIn() && exists(userPath()) && me().disabled == false;
    }

    function isAdmin() {
      return active() && me().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if active()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language'])
        && request.resource.data.language in ['ar', 'en'];
      allow create, delete: if false;
    }

    match /bookings/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if active() && (id == 'pricing' || id == 'tripDates' || id == 'programs');
      allow write: if false;
    }

    match /referralTypes/{id} {
      allow read: if active();
      allow write: if false;
    }
  }
}
